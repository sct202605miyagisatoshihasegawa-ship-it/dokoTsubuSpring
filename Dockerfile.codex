FROM eclipse-temurin:25.0.1_8-jdk-jammy@sha256:7baba0e6d505fc261acc3ab754d9b14f6d09b356ad4bf1440c331011b8b2bb93

ARG CODEX_VERSION=0.160.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash developer \
    && mkdir -p /home/developer/.codex /opt/codex \
    && chown -R developer:developer /home/developer

RUN curl -fsSL https://chatgpt.com/codex/install.sh -o /tmp/codex-install.sh \
    && CODEX_HOME=/opt/codex \
       CODEX_INSTALL_DIR=/usr/local/bin \
       CODEX_NON_INTERACTIVE=1 \
       sh /tmp/codex-install.sh --release "${CODEX_VERSION}" \
    && rm /tmp/codex-install.sh \
    && codex --version

RUN git config --system --add safe.directory /workspace/dokoTsubuSpring

ENV CODEX_HOME=/home/developer/.codex

WORKDIR /workspace/dokoTsubuSpring

USER developer

CMD ["bash"]